{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewlab.local/schemas/crew-spec.schema.json",
  "title": "CrewLab crew-spec",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "goal",
    "agents",
    "tasks",
    "meetings",
    "definition_of_done",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "agents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "role", "task_id"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "task_id": { "type": "string" },
          "mission": { "type": "string" },
          "backend": {
            "type": "string",
            "description": "CLI runtime: manual|dry-run|hermes|grok|codex|claude|openclaw|opencode|cursor|shell|custom",
            "enum": [
              "manual",
              "dry-run",
              "hermes",
              "grok",
              "codex",
              "claude",
              "openclaw",
              "opencode",
              "cursor",
              "shell",
              "custom"
            ]
          },
          "cli": {
            "type": "string",
            "description": "Optional command template override ({prompt_file}, {cwd}, …)"
          },
          "workdir": { "type": "string" },
          "tools": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Advisory tool list (backend owns real tools)"
          },
          "manager": {
            "type": "boolean",
            "description": "Hierarchical process manager flag"
          },
          "knowledge_paths": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["task_ids"] },
            { "required": ["tasks"] }
          ]
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "blocked", "done", "skipped"]
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_output": {
            "type": "string",
            "description": "CrewAI-style expected_output for kickoff prompts"
          },
          "tools": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "process": {
      "type": "string",
      "enum": ["collaborative", "sequential", "hierarchical"]
    },
    "knowledge_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Shared knowledge mounted into task prompts"
    },
    "meetings": {
      "type": "object",
      "properties": {
        "default_kind": {
          "type": "string",
          "enum": ["kickoff", "standup", "sync", "review", "retro", "decision", "closeout"]
        },
        "cadence": { "type": "string" },
        "phases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "definition_of_done": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "stop_conditions": { "type": "object" }
  },
  "additionalProperties": true
}
